# App
NODE_ENV=development
APP_ENV=development
PORT=7000

# MongoDB
MONGO_URI=mongodb://localhost:27017/partshub-australia

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h

# 32-byte hex string (64 hex chars) used to encrypt long-lived third-party
# credentials at rest (currently: each tenant's eBay refresh_token — see
# utils/crypto/tokenCipher.js). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# OTP / Password Reset
OTP_EXPIRY_MINUTES=2
PASSWORD_RESET_EXPIRY_MINUTES=15

# Redis (for Bull email queue)─
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379  # overrides host/port if set

# SMTP — the PLATFORM's own mailbox. Used for platform-level system email
# (login OTP, password reset, account verified) and error alerts, always.
# Customer-facing order email (confirmed/shipped/ready-for-pickup/receipt) is
# BYOK — each tenant sets their own SMTP host/port/user/password via
# Settings → Email, stored encrypted (see smtp.keys.service.js) — and falls
# back to this platform mailbox only if a tenant hasn't configured theirs yet.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERTS_TO=
# Throttling — defaults are conservative for free/shared SMTP sandboxes
# (e.g. Mailtrap testing plans return "Too many emails per second" above
# a few msgs/sec). Raise these once on a real provider with higher limits.
SMTP_MAX_CONNECTIONS=1
SMTP_RATE_LIMIT=1
SMTP_RATE_DELTA_MS=1000

# Email branding
EMAIL_FROM_NAME=Parts Hub Australia
EMAIL_FROM=no-reply@partshub.com.au
SUPPORT_EMAIL=support@partshub.com.au
APP_NAME=Parts Hub Australia
# Admin dashboard base URL (internal-account emails, e.g. accountVerified's login link)
CLIENT_URL=http://localhost:5173
# Storefront base URL, for any customer-facing email that needs to link back to it
STOREFRONT_URL=http://localhost:5174

# Apex domain payment links are built under (payment.<domain> or
# <tenant-slug>.<domain>, per tenant — see Tenant.payment_domain_mode).
# Leave unset in local dev — payment links fall back to CLIENT_URL.
# PAYMENT_LINK_DOMAIN=partshubaustralia.com.au

# CORS
# Comma-separated list of allowed origins (leave empty in dev to allow all)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info

# File Uploads
# Absolute path where uploaded files are stored (defaults to <server_root>/uploads)
# UPLOADS_DIR=/var/www/partshub/uploads
# Public URL prefix served by the static middleware
UPLOADS_URL=http://localhost:7000/uploads

# eBay Integration — multi-tenant. These two belong to OUR eBay Application
# (registered once in the eBay Developer Program) and are shared across every
# tenant, like a Stripe platform key. Leave blank to disable eBay sync
# platform-wide (products will still save locally).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: override API base URLs (normally left unset — each tenant's own
# `sandbox` flag on their EbaySettings record derives the right base URL).
EBAY_API_BASE_URL=
EBAY_TAXONOMY_BASE_URL=
# eBay's "RuName" — a redirect-URL identifier registered once in the eBay
# Developer Portal against this Application, pointed at
# <API_BASE_URL>/api/v1/ebay/oauth/callback. Required for the OAuth consent
# flow (a tenant clicking "Connect eBay" in Settings) — eBay will not
# redirect anywhere else.
EBAY_REDIRECT_URI=
#
# Everything seller-specific — refresh_token, marketplace, sandbox, business
# policy IDs, warehouse address, webhook verification token — is per-tenant
# now, obtained via the OAuth consent flow (GET /api/v1/ebay/oauth/connect-url)
# and configured via PUT /api/v1/ebay/settings (see EbaySettings model /
# ebay.settings.service.js), not env vars. The webhook callback URL is shared
# across every tenant — /api/v1/ebay/webhook?wt=<opaque webhook_token> —
# registered per-tenant via POST /api/v1/ebay/webhook/subscribe once their
# refresh_token is set.

# Stripe — BYOK. Each tenant supplies their own secret/publishable key via
# Settings → Payment Account (PUT /api/v1/tenant-settings/stripe/keys),
# validated against Stripe and stored encrypted on their Tenant document —
# see server/src/services/stripe/stripe.keys.service.js.
# Local-dev-only fallback for testing with `stripe listen` (paste whatever
# it prints) — tried only outside production, only after a tenant's own
# stored secret fails to verify. Leave unset in staging/production.
STRIPE_DEV_WEBHOOK_SECRET=
STRIPE_CURRENCY=aud

# Superadmin seed — used only by scripts/seedSuperAdmin.js to create the
# first platform superadmin account. Not read anywhere else.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_PHONE=

# Typesense — product full-text/fuzzy search + autocomplete. Self-hosted via
# docker-compose's `typesense` service in local dev. TYPESENSE_API_KEY must
# match the key the server is started with (docker-compose.yml sets it via
# TYPESENSE_API_KEY too) — see server/src/services/search/typesense.client.js.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
