# App
NODE_ENV=development
APP_ENV=development
PORT=7000

# MongoDB
MONGO_URI=mongodb://localhost:27017/partshub

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# OTP / Password Reset
OTP_EXPIRY_MINUTES=2
PASSWORD_RESET_EXPIRY_MINUTES=15

# Redis (for Bull email queue)─
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379  # overrides host/port if set

# SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERTS_TO=
SALES_EMAIL=sales@partshubaustralia.com.au

# Email branding
EMAIL_FROM_NAME=Parts Hub Australia
EMAIL_FROM=no-reply@partshub.com.au
SUPPORT_EMAIL=support@partshub.com.au
APP_NAME=Parts Hub Australia
CLIENT_URL=http://localhost:5173

# CORS
# Comma-separated list of allowed origins (leave empty in dev to allow all)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info

# File Uploads
# Absolute path where uploaded files are stored (defaults to <server_root>/uploads)
# UPLOADS_DIR=/var/www/partshub/uploads
# Public URL prefix served by the static middleware
UPLOADS_URL=http://localhost:7000/uploads

# eBay Integration
# Leave blank to disable eBay sync (products will still save locally)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_AU
# Set to "true" to use eBay sandbox environment
EBAY_SANDBOX=false
# Optional: override API base URLs (defaults derived from EBAY_SANDBOX)
EBAY_API_BASE_URL=
EBAY_TAXONOMY_BASE_URL=
# Must byte-for-byte match the URL entered in eBay's Marketplace Account Deletion compliance form.
# Example: https://admin.partshubaustralia.com.au/api/v1/ebay/webhook
EBAY_WEBHOOK_ENDPOINT_URL=

# Warehouse address — used to auto-create the merchant location on eBay if it doesn't exist.
# All four fields are required for auto-creation; without them a missing location will fail with a clear error.
EBAY_WAREHOUSE_STREET=
EBAY_WAREHOUSE_CITY=
EBAY_WAREHOUSE_STATE=
EBAY_WAREHOUSE_POSTCODE=
EBAY_WAREHOUSE_COUNTRY=AU
# Optional
EBAY_WAREHOUSE_PHONE=
