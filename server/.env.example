# App
NODE_ENV=development
APP_ENV=development
PORT=7000

# MongoDB
MONGO_URI=mongodb://localhost:27017/partshub-australia

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# 32-byte hex key, used to encrypt stored credentials — generate: openssl rand -hex 32
ENCRYPTION_KEY=

# OTP / Password Reset
OTP_EXPIRY_MINUTES=2
PASSWORD_RESET_EXPIRY_MINUTES=15

# Redis (Bull queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# SMTP — platform mailbox, used for system email + alerts
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERTS_TO=

# SMTP throttling
SMTP_MAX_CONNECTIONS=1
SMTP_RATE_LIMIT=1
SMTP_RATE_DELTA_MS=1000

# Email branding
EMAIL_FROM_NAME=Auto Parts Pro
EMAIL_FROM=no-reply@partshub.com.au
SUPPORT_EMAIL=support@partshub.com.au
APP_NAME=Auto Parts Pro

# Frontend URLs
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
STOREFRONT_URL=http://localhost:5174

# Logging
LOG_LEVEL=info

# File uploads — public URL prefix
UPLOADS_URL=http://localhost:7000/uploads

# eBay integration — leave blank to disable eBay sync.
# IMPORTANT: EBAY_CLIENT_ID/EBAY_CLIENT_SECRET must be your app's PRODUCTION
# keyset (App ID + Cert ID from the eBay Developer Portal), even if every
# tenant you're testing with is sandbox-connected. Taxonomy/catalog calls
# (category tree, category aspects, condition-adjacent lookups) always use
# eBay's production endpoints — its sandbox taxonomy tree doesn't work — so
# Sandbox app keys here fail with "invalid_client" on anything that touches
# categories, even though everything else (listing publish/sync) can run
# fully sandboxed. See ebay.api.service.js#getCatalogToken.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_TAXONOMY_BASE_URL=
EBAY_REDIRECT_URI=

# Stripe
STRIPE_CURRENCY=aud

# Typesense (product search)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
