# App
NODE_ENV=development
APP_ENV=development
PORT=7000

# MongoDB
MONGO_URI=mongodb://localhost:27017/partshub-australia

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# 32-byte hex key for stored credentials: openssl rand -hex 32
ENCRYPTION_KEY=

# OTP / Password Reset
OTP_EXPIRY_MINUTES=2
PASSWORD_RESET_EXPIRY_MINUTES=15

# Team invites: set-password link lifetime (hours) and resend cooldown (seconds)
USER_INVITE_EXPIRY_HOURS=24
USER_INVITE_RESEND_COOLDOWN_SECONDS=120

# Redis (Bull queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Full URL (managed redis:// or rediss://); overrides HOST/PORT. Blank locally.
REDIS_URL=
# Max ms a stopping worker drains jobs; keep under compose stop_grace_period.
WORKER_SHUTDOWN_TIMEOUT_MS=8000

# SMTP — platform mailbox, used for system email + alerts
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERTS_TO=  # error alerts + "Request a Demo" marketing-site submissions

# SMTP throttling
SMTP_MAX_CONNECTIONS=1
SMTP_RATE_LIMIT=1
SMTP_RATE_DELTA_MS=1000

# Email branding
EMAIL_FROM_NAME=Auto Parts Pro
EMAIL_FROM=no-reply@partshub.com.au
SUPPORT_EMAIL=support@partshub.com.au
APP_NAME=Auto Parts Pro

# Frontend URLs
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
STOREFRONT_URL=http://localhost:5174

# Payment-link apex (payment.<d> or <slug>.<d>); needs DNS+TLS. Blank locally.
PAYMENT_LINK_DOMAIN=

# Logging
LOG_LEVEL=info

# Uploads dir; blank means <repo>/uploads (set it for a mounted volume).
UPLOADS_DIR=
UPLOADS_URL=http://localhost:7000/uploads

# eBay (blank disables). Use the PRODUCTION keyset: taxonomy has no sandbox.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_TAXONOMY_BASE_URL=
EBAY_REDIRECT_URI=
# Global eBay API base override; blank lets each tenant's sandbox flag decide.
EBAY_API_BASE_URL=
# eBay queue has no rate limit; set both values only to start throttling.
EBAY_QUEUE_RATE_MAX=
EBAY_QUEUE_RATE_DURATION_MS=

# Google Shopping OAuth (blank disables); redirect URI: /google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Channel sync tuning; blank keeps defaults. Log row retention in days:
CHANNEL_SYNC_LOG_TTL_DAYS=30
# Also log successful syncs; floods the collection, so debugging only.
CHANNEL_LOG_SUCCESSES=false
# Consecutive transport/auth failures before a channel's breaker trips.
CHANNEL_CIRCUIT_BREAKER_THRESHOLD=10
# Window that collapses rapid same-listing syncs into one job.
CHANNEL_SYNC_DEBOUNCE_MS=5000
# Listings per syncBatch cursor chunk before a batch publish call.
CHANNEL_BATCH_CHUNK_SIZE=500

# Days before a listing is re-pushed; keep under Google's 30-day expiry.
CHANNEL_REFRESH_INTERVAL_DAYS=25
# How often the sweep actually runs, in hours.
CHANNEL_REFRESH_SWEEP_INTERVAL_HOURS=24
# Kill switch — set to false to disable the sweep without a deploy.
CHANNEL_REFRESH_SWEEP_ENABLED=true

# Stripe
STRIPE_CURRENCY=aud
# Dev only: `stripe listen` secret, tried after the tenant's. Never in prod.
STRIPE_DEV_WEBHOOK_SECRET=

# Typesense (product search)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_TIMEOUT_SECONDS=5
