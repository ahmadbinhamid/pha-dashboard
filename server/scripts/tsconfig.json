{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    // Scripts in this folder import the frontend's own generator/util
    // modules directly (see resyncStaleEbayListings.ts's own comment on
    // why — it must always generate exactly what the dashboard would,
    // never a re-implementation) — same "@/" mapping as the frontend's own
    // tsconfig.json, just resolved from here instead of from src/.
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": ["."]
}
