{{> _header}}

<div style="max-width:600px;margin:0 auto;padding:20px;font-family:Arial,sans-serif;">
  <h2 style="color:#333;margin-top:0;">New Storefront Inquiry</h2>

  <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-bottom:20px;">
    <tr>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#999;font-size:13px;width:120px;">Name</td>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#333;font-size:14px;">{{customer_name}}</td>
    </tr>
    <tr>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#999;font-size:13px;">Email</td>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#333;font-size:14px;"><a href="mailto:{{customer_email}}" style="color:#0066cc;">{{customer_email}}</a></td>
    </tr>
    {{#if customer_phone}}
    <tr>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#999;font-size:13px;">Phone</td>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#333;font-size:14px;">{{customer_phone}}</td>
    </tr>
    {{/if}}
    <tr>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#999;font-size:13px;">Subject</td>
      <td style="padding:10px 0;border-bottom:1px solid #eee;color:#333;font-size:14px;">{{subject}}</td>
    </tr>
  </table>

  <h4 style="color:#555;margin-bottom:8px;">Message</h4>
  <div style="background:#f8f9fa;border-left:4px solid #0066cc;padding:16px;border-radius:4px;color:#333;font-size:14px;line-height:1.6;white-space:pre-wrap;">{{message}}</div>

  <p style="color:#999;font-size:12px;margin-top:24px;">
    Received via the {{app_name}} storefront inquiry form.
  </p>
</div>

{{> _footer}}
