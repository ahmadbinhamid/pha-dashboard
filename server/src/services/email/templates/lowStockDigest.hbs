<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;overflow:hidden;">
        <tr>
          <td style="height:4px;line-height:4px;font-size:0;background:#f97015;">&nbsp;</td>
        </tr>

        <tr>
          <td style="padding:28px 32px 20px 32px;">
            <span style="display:inline-block;background:#fff2e9;color:#f97015;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:4px 10px;border-radius:999px;">
              Low Stock Alert
            </span>
            <h1 style="margin:14px 0 0;font-size:20px;line-height:1.3;color:#14181f;font-weight:700;">{{app_name}}</h1>
            <p style="margin:6px 0 0;color:#6b7280;font-size:14px;line-height:1.5;">
              {{item_count}} {{item_word}} running low on stock. Full details are in the attached PDF report.
            </p>
          </td>
        </tr>

        <tr><td style="padding:0 32px;"><div style="height:1px;background:#e5e7eb;line-height:1px;font-size:0;">&nbsp;</div></td></tr>

        <tr>
          <td style="padding:20px 32px 8px 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
              <thead>
                <tr>
                  <th align="left" style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;padding:0 0 10px;border-bottom:2px solid #e5e7eb;">Item</th>
                  <th align="left" style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;padding:0 0 10px;border-bottom:2px solid #e5e7eb;">SKU</th>
                  <th align="right" style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;padding:0 0 10px;border-bottom:2px solid #e5e7eb;">Stock</th>
                </tr>
              </thead>
              <tbody>
                {{#each items}}
                <tr>
                  <td style="padding:10px 0;font-size:14px;color:#14181f;border-bottom:1px solid #f0f1f3;">{{this.title}}</td>
                  <td style="padding:10px 0;font-size:12.5px;color:#6b7280;font-family:ui-monospace,Menlo,Consolas,monospace;border-bottom:1px solid #f0f1f3;">{{this.sku}}</td>
                  <td align="right" style="padding:10px 0;font-size:14px;font-weight:700;color:#ef4444;border-bottom:1px solid #f0f1f3;">{{this.stock}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:8px 32px 28px 32px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f8f9fb;border:1px solid #e5e7eb;border-radius:8px;">
              <tr>
                <td style="padding:12px 16px;font-size:13px;color:#374151;">
                  <strong style="color:#14181f;">Attached:</strong> the full low-stock report as a PDF, with SKU and variant details for every item above.
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">
        <tr>
          <td style="padding:16px 8px 0;color:#9ca3af;font-size:12px;line-height:1.5;text-align:center;">
            You're receiving this because low-stock email alerts are enabled in Inventory Settings.
            Need help? Contact <a href="mailto:{{support_email}}" style="color:#6b7280;">{{support_email}}</a>.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
