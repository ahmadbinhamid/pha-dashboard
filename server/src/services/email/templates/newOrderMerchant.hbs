<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;overflow:hidden;">
        <tr>
          <td style="height:4px;line-height:4px;font-size:0;background:#f97015;">&nbsp;</td>
        </tr>

        <tr>
          <td style="padding:28px 32px 20px 32px;">
            <span style="display:inline-block;background:#e8f0fe;color:#2563eb;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:4px 10px;border-radius:999px;">
              New Storefront Order
            </span>
            <h1 style="margin:14px 0 0;font-size:20px;line-height:1.3;color:#14181f;font-weight:700;">Order {{number}} &middot; {{total}}</h1>
            <p style="margin:6px 0 0;color:#6b7280;font-size:14px;line-height:1.5;">
              {{customer_name}} placed and paid for this order on your website. It's ready to fulfil.
            </p>
          </td>
        </tr>

        <tr><td style="padding:0 32px;"><div style="height:1px;background:#e5e7eb;line-height:1px;font-size:0;">&nbsp;</div></td></tr>

        <tr>
          <td style="padding:20px 32px 8px 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
              <thead>
                <tr>
                  <th align="left" style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;padding:0 0 10px;border-bottom:2px solid #e5e7eb;">Item</th>
                  <th align="right" style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;padding:0 0 10px;border-bottom:2px solid #e5e7eb;">Qty</th>
                  <th align="right" style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.04em;padding:0 0 10px;border-bottom:2px solid #e5e7eb;">Total</th>
                </tr>
              </thead>
              <tbody>
                {{#each items}}
                <tr>
                  <td style="padding:10px 0;font-size:14px;color:#14181f;border-bottom:1px solid #f0f1f3;">
                    {{this.name}}
                    {{#if this.sku}}<div style="margin-top:2px;font-size:12px;color:#6b7280;font-family:ui-monospace,Menlo,Consolas,monospace;">{{this.sku}}</div>{{/if}}
                  </td>
                  <td align="right" style="padding:10px 0;font-size:14px;color:#14181f;border-bottom:1px solid #f0f1f3;">{{this.quantity}}</td>
                  <td align="right" style="padding:10px 0;font-size:14px;font-weight:600;color:#14181f;border-bottom:1px solid #f0f1f3;">{{this.line_total}}</td>
                </tr>
                {{/each}}
                <tr>
                  <td colspan="2" style="padding:10px 0 0;font-size:13px;color:#6b7280;">Shipping ({{delivery_label}})</td>
                  <td align="right" style="padding:10px 0 0;font-size:13px;color:#6b7280;">{{shipping}}</td>
                </tr>
                <tr>
                  <td colspan="2" style="padding:6px 0 0;font-size:15px;font-weight:700;color:#14181f;">Total paid</td>
                  <td align="right" style="padding:6px 0 0;font-size:15px;font-weight:700;color:#14181f;">{{total}}</td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding:16px 32px 8px 32px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f8f9fb;border:1px solid #e5e7eb;border-radius:8px;">
              <tr>
                <td style="padding:12px 16px;font-size:13px;line-height:1.6;color:#374151;">
                  <strong style="color:#14181f;">Customer:</strong> {{customer_name}}<br />
                  {{#if customer_email}}<a href="mailto:{{customer_email}}" style="color:#2563eb;">{{customer_email}}</a><br />{{/if}}
                  {{#if customer_phone}}{{customer_phone}}<br />{{/if}}
                  <strong style="color:#14181f;">{{delivery_label}}:</strong> {{#if address}}{{address}}{{else}}Customer collects from your store{{/if}}
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:16px 32px 28px 32px;">
            <a href="{{order_url}}" style="display:inline-block;background:{{primary_color}};color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;padding:11px 22px;border-radius:8px;">View order in dashboard</a>
          </td>
        </tr>
      </table>

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">
        <tr>
          <td style="padding:16px 8px 0;color:#9ca3af;font-size:12px;line-height:1.5;text-align:center;">
            Sent by {{platform_name}} because {{app_name}} received a paid storefront order.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
