{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <h2 style="color: #28a745; text-align: center;">Thanks for Your Order!</h2>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hello {{name}},
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    We've received payment for order <strong>{{order_number}}</strong> and we're getting it ready.
  </p>

  <div style="text-align: center; margin: 30px 0;">
    <a href="{{view_order_url}}" style="background-color: #007bff; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: bold;">
      View Your Order
    </a>
  </div>

  <p style="color: #666; font-size: 14px; line-height: 1.5;">
    We'll email you again once your order ships (or is ready for pickup) with your tax invoice attached.
  </p>
</div>

{{> _footer}}
