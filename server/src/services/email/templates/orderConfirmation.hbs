{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hi {{name}},
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Thank you for placing your order with {{app_name}}.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Order Reference Number: <strong>{{order_number}}</strong>
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Your order has been successfully received and is currently being prepared.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Once your order has been dispatched, we will send you another email containing your courier details and tracking information.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Thank you for choosing {{app_name}}.
  </p>
</div>

{{> _footer}}
