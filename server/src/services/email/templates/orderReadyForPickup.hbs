{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hi {{name}},
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Great news!
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Your order <strong>{{order_number}}</strong> is now ready for collection.
  </p>

  <div style="background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; padding: 20px; margin: 20px 0;">
    <h3 style="color: #155724; margin: 0 0 10px 0;">You can collect your order from:</h3>
    <p style="color: #155724; margin: 0 0 12px 0; font-size: 14px;">
      {{pickup_location_name}}<br />
      {{pickup_address}}<br />
      {{pickup_country}}
    </p>
    <h3 style="color: #155724; margin: 0 0 6px 0;">Trading Hours</h3>
    <p style="color: #155724; margin: 0; font-size: 14px;">
      {{#each trading_hours}}
        {{this}}<br />
      {{/each}}
    </p>
  </div>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Please bring your Order Reference Number when collecting your order so we can provide you with a quick and smooth pickup experience.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    If you have any questions before collecting your order, please don't hesitate to contact us.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Thank you for choosing {{app_name}}.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Kind regards,<br />
    {{app_name}}
  </p>
</div>

{{> _footer}}
