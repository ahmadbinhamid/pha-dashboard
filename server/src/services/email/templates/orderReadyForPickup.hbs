{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <h2 style="color: #28a745; text-align: center;">Your Order Is Ready for Pickup!</h2>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hello {{name}},
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Order <strong>{{order_number}}</strong> is ready for collection at our Melbourne Warehouse.
  </p>

  <div style="background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; padding: 20px; margin: 20px 0;">
    <h3 style="color: #155724; margin: 0 0 10px 0;">Collection Details</h3>
    <p style="color: #155724; margin: 0; font-size: 14px;">
      Parts Hub Australia — Melbourne Warehouse<br />
      123 Performance Way, Melbourne VIC 3000
    </p>
  </div>

  <p style="color: #666; font-size: 14px; line-height: 1.5;">
    Your tax invoice is attached to this email — please bring it (or your order number) with you when collecting.
  </p>
</div>

{{> _footer}}
