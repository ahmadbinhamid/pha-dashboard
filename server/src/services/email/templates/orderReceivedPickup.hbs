{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hi {{name}},
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Thank you for placing your order with Parts Hub Australia.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Your order has been successfully received.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Order Reference Number: <strong>{{order_number}}</strong>
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Your order is currently being prepared.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    We will send you another email as soon as your order is ready for collection.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Thank you for choosing Parts Hub Australia.
  </p>
</div>

{{> _footer}}
