{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hi {{name}},
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Your order <strong>{{order_number}}</strong> is ready for payment. Please use the button below to pay securely online.
  </p>

  {{#if amount_due}}
  <div style="background-color: #fff3cd; border: 1px solid #ffeeba; border-radius: 8px; padding: 20px; margin: 20px 0;">
    <h3 style="color: #856404; margin: 0 0 10px 0;">Amount Due: {{amount_due}}</h3>
  </div>
  {{/if}}

  <div style="text-align: center; margin: 30px 0;">
    <a href="{{payment_url}}" style="background-color: #1a73e8; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 6px; font-size: 16px; display: inline-block;">
      Pay Now
    </a>
  </div>

  <p style="color: #999; font-size: 13px; line-height: 1.5;">
    If the button above doesn't work, copy and paste this link into your browser:<br />
    <a href="{{payment_url}}" style="color: #1a73e8;">{{payment_url}}</a>
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Thank you for choosing {{app_name}}.
  </p>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Kind regards,<br />
    {{app_name}}
  </p>
</div>

{{> _footer}}
