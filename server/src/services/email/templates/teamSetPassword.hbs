{{> _header}}

<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <h2 style="color: #18140f; text-align: center;">Set up your {{organisation_name}} account</h2>

  <p style="color: #666; font-size: 16px; line-height: 1.5;">
    Hi {{first_name}}, {{#if inviter_name}}{{inviter_name}} has added you{{else}}you've been added{{/if}}
    to <strong>{{organisation_name}}</strong> on {{app_name}}. Choose a password to get started.
  </p>

  <div style="text-align: center; margin: 30px 0;">
    <a href="{{set_password_url}}" style="background-color: {{primary_color}}; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: bold;">
      Set your password
    </a>
  </div>

  <p style="color: #666; font-size: 14px; line-height: 1.5;">
    This link is for <strong>{{email}}</strong>, works once, and expires in {{expires_in}}.
    If it expires, ask your admin to resend it.
  </p>

  <p style="color: #999; font-size: 13px; line-height: 1.5;">
    Not expecting this? Ignore this email; no one can use the account until a password is set.
  </p>

  <p style="color: #999; font-size: 12px; word-break: break-all;">
    Button not working? Use this link instead:<br />
    <a href="{{set_password_url}}" style="color: {{primary_color}};">{{set_password_url}}</a>
  </p>
</div>

{{> _footer}}
